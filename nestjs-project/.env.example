# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO locally / S3 in production) — use the Compose service name as host
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_BUCKET=streamtube-videos
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_EXPIRES=3600

# Queue (Redis / BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
VIDEO_QUEUE_ATTEMPTS=3
VIDEO_QUEUE_BACKOFF_MS=5000

# Video processing
VIDEO_MAX_SIZE_BYTES=10737418240
VIDEO_MULTIPART_PART_SIZE=52428800
THUMBNAIL_TIMESTAMP=50%
